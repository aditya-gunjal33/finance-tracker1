
pipeline {
    agent any

    
tools {
    maven 'Maven3'
    jdk   'jdk21'
}


    environment {
        IMAGE_NAME = 'harshittare/finance-tracker'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir('finance-tracker') {
                    bat 'mvn clean compile -B'
                }
            }
        }
        
        stage('Check Java Version') {
            steps {
                 bat 'java --version'
                 bat 'mvn --version'
                 }
              }

        stage('Unit Tests') {
            steps {
                dir('finance-tracker') {
                    bat 'mvn test -B'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: 'finance-tracker/target/surefire-reports/*.xml'
                }
            }
        }

        stage('Package') {
            steps {
                dir('finance-tracker') {
                    bat 'mvn package -DskipTests -B'
                }
                archiveArtifacts artifacts:
                    'finance-tracker/target/*.jar',
                    fingerprint: true
            }
        }

        stage('Docker Build') {
            steps {
                bat 'docker build -t %IMAGE_NAME%:%BUILD_NUMBER% -t %IMAGE_NAME%:latest finance-tracker'
            }
        }

        stage('Docker Push') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_TOKEN'
                )]) {
                    bat '''
                        docker login -u "%DOCKER_USER%" --password-stdin < NUL
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Finance Tracker pipeline completed successfully.'
        }
        failure {
            echo 'Pipeline failed. Check the stage logs.'
        }
    }
}
